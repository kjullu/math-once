#import "../math-once.typ": calculation-builder, school-bridge, school
#set page(width: 18cm, height: auto, margin: 1cm)
#let run = calculation-builder(key: "integration", strict: true, digits: 3)
#run("g(x) := x^2 - 4")
#run("h(x) := 3*x")
#run("a1 := 7")
#run("t2 := a1 + 2")
#run("stored10 := t2 + 1")
#context { assert(run().t2.value == 9); assert(run().stored10.value == 10) }
#school-bridge(callback => {
  let g = callback("g(x)")
  assert(calc.abs(school.integral(g, 0, 2, steps: 10) + 16/3) < 1e-8)
  assert(calc.abs(school.derivative(g, 3) - 6) < 1e-6)
  assert(calc.abs(school.bisect(g, 0, 3) - 2) < 1e-8)
  school.plot((g, callback("h(x)")), 0, 3, steps: 20)
}, key: "integration")
#assert(school.describe((1,2,3,4,5), method: "median-halves").q1 == 1.5)
#school.box-plot((1,2,3,4,5), method: "median-halves")
#let degrees = school.angles(mode: "degrees")
#assert(calc.abs((degrees.vector-angle)((1,0),(0,1)) - 90) < 1e-8)
#assert(calc.abs((degrees.triangle)(3,4,5).gamma - 90) < 1e-8)
#assert(calc.abs((degrees.sin)(30) - 0.5) < 1e-8)
#run("average := " + school.value-source(school.mean((2,4,6))))
#run("average * 3")
#run("zeros := solve(g(x),x)")
#run("slope := diff(h(x),x)")
#context {
  assert(run().slope != none)
}
#run("l(x,y) := x + 2*y")
#school-bridge(callback => {
  let f = callback("l(x,y)", parameters: ("x","y"))
  assert(f(2,3) == 8)
}, key: "integration")
#context {
  assert(run().zeros.roots.len() == 2)
}
#run("mass := 2 g", hidden: true)
#context assert(run().mass.unit == "g")

// Compilation is independent of sampling density; use public defaults here.
#run("p(x) := ln(x) + exp(x) + log(x)")
#run("dp(x) := diff(p(x),x)")
#school-bridge(callback => {
  let p = callback("p(x)")
  let dp = callback("dp(x)")
  assert(calc.abs(p(1) - calc.e) < 1e-8)
  assert(calc.abs(dp(1) - (1 + calc.e + 1/calc.ln(10))) < 1e-7)
  let trig = callback("sin(x)")
  assert(calc.abs(school.integral(trig,0,calc.pi) - 2) < 1e-8)
  assert(calc.abs(school.derivative(trig,0) - 1) < 1e-7)
  let cubic = callback("x^3 - x")
  assert(school.roots(cubic,-2,2).len() == 3)
  assert(calc.abs(school.integral(cubic,-2,2)) < 1e-8)
  school.plot((cubic,),-2,2)
}, key:"integration", angles:"radians")
#school-bridge(callback => {
  assert(calc.abs(callback("sin(x)")(30) - 0.5) < 1e-8)
}, key:"integration", angles:"degrees")
#let rad = calculation-builder(key:"rad",angles:"radians",strict:true)
#rad("sine := sin(pi/2)")
#context assert(calc.abs(rad().sine.exact - 1) < 1e-8)
#run("natural := ln(exp(2))")
#context assert(calc.abs(run().natural.exact - 2) < 1e-8)
#run("equation := solve(x^2 = 4,x)")
#context assert(run().equation.roots.len() == 2)
#run("dp(2)")
#run("storedDerivative := diff(p(x),x)")
#school-bridge(callback => {
  let derivative = callback("storedDerivative(x)")
  assert(calc.abs(derivative(2) - (0.5 + calc.exp(2) + 1/(2*calc.ln(10)))) < 1e-7)
}, key:"integration", angles:"radians")
#run("\"a\" := 2")
#run("\"b\" := 1")
#run("fitted := \"a\"*4 + \"b\"")
#run("duration := 2 a")
#context { assert(run().fitted.exact == 9); assert(run().duration.unit == "a") }

#rad("explicitDegree := cos(60°)")
#rad("explicitRad := sin(1 rad)")
#rad("inverse := asin(0.5)")
#rad("nested := cos(acos(0.2))")
#rad("stored := sin(inverse)")
#rad("ratio := atan(1)/pi")
#rad("quadrant := atan2(1,1)")
#rad("q(t) := t^3")
#rad("dq := diff(q(t),t)")
#rad("answer := dq(2)")
#rad("h(t) := sin(t)")
#rad("dhh := diff(h(t),t)")
#rad("slope := dhh(pi)")
#rad("F(x) := integrate(x^2,x)")
#rad("area := F(2)")
#context {
  let values = rad()
  assert(calc.abs(values.explicitDegree.exact - 0.5) < 1e-8)
  assert(calc.abs(values.explicitRad.exact - calc.sin(1)) < 1e-8)
  assert(calc.abs(values.inverse.exact - calc.pi/6) < 1e-8)
  assert(calc.abs(values.nested.exact - 0.2) < 1e-8)
  assert(calc.abs(values.stored.exact - 0.5) < 1e-8)
  assert(calc.abs(values.ratio.exact - 0.25) < 1e-8)
  assert(calc.abs(values.quadrant.exact - calc.pi/4) < 1e-8)
  assert(values.answer.exact == 12)
  assert(calc.abs(values.slope.exact + 1) < 1e-8)
  assert(calc.abs(values.area.exact - 8/3) < 1e-8)
}

#school-bridge(callback => {
  let f = callback("atan2(y,x)", parameters:("y","x"))
  assert(calc.abs(f(1,1)-calc.pi/4) < 1e-8)
}, key:"rad", angles:"radians")
#rad("angle1 := acos(0.2)")
#rad("angle2 := atan(1)")
#rad("explicitStored := 60°")
#rad("fromStored := cos(explicitStored)")
#context {
  assert(calc.abs(rad().angle1.exact - calc.acos(0.2).rad()) < 1e-8)
  assert(calc.abs(rad().angle2.exact - calc.pi/4) < 1e-8)
  assert(calc.abs(rad().fromStored.exact - 0.5) < 1e-8)
}

#rad("q(t,y) := t^2*y")
#rad("dq := diff(q(t,y),t)")
#rad("multi := dq(2,3)")
#rad("q(theta) := theta^3")
#rad("dq := diff(q(theta),theta)")
#rad("greekResult := dq(2)")
#context {
  assert(rad().multi.exact == 12)
  assert(rad().greekResult.exact == 12)
}
#rad("ln(-(-1/4))/(-3/10)")
#rad("diff(x*exp(-x),x)")
#rad("integrate(1/x,x)")
#rad("(-2.5)^2")

// Constant CAS expressions keep exact ASTs and also work in numeric calculations.
#rad("areaExact := integrate(x^2,x,0,2)")
#rad("tripleArea := areaExact*3")
#rad("limitExact := limit(sin(x)/x,x,0)")
#rad("twiceLimit := limitExact*2")
#rad("logExact := integrate(1/x,x,1,2)")
#rad("twiceLog := logExact*2")
#rad("expExact := integrate(exp(x),x,0,1)")
#rad("twiceExp := expExact*2")
#rad("model(x) := x-ln(x)")
#rad("dm(x) := diff(model(x),x)")
#rad("dmAtTwo := dm(2)")
#rad("F(3)")
#rad("L(x) := integrate(1/x,x)")
#rad("L(2)")
#context {
  assert(rad().tripleArea.exact == 8)
  assert(rad().twiceLimit.exact == 2)
  assert(calc.abs(rad().twiceLog.exact - 2*calc.ln(2)) < 1e-8)
  assert(calc.abs(rad().twiceExp.exact - 2*(calc.e - 1)) < 1e-8)
  assert(rad().dmAtTwo.exact == 0.5)
}
#rad("sineModel(x) := sin(x)")
#rad("ds(x) := diff(sineModel(x),x)")
#rad("nestedModel(x) := ds(x)+1")
#school-bridge(callback => {
  assert(callback("nestedModel(x)")(0) == 2)
},key:"rad",angles:"radians")
#let significant = calculation-builder(key:"significant-cas",strict:true,digits:auto,auto-digits:"significant",angles:"radians")
#significant("constant := integrate(1/x,x,1,2)")
#significant("product := constant*2.00")
#context {
  assert(calc.abs(significant().product.exact - 2*calc.ln(2)) < 1e-8)
  assert(significant().product.significant-digits == 3)
}
