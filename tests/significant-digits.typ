#import "../math-once.typ": calculation-builder
#set page(width: 18cm, height: auto, margin: 1cm)
#let eq = calculation-builder(key: "significant", digits: auto, auto-digits: "significant", strict: true)
#eq(`torque := 4.00 cm * 8.00 N to N*m`)
#eq(`inertia := 1.28e-6 kg*m^2`)
#eq(`acceleration := torque / inertia`)
#eq(`again := torque * 1.000`)
#eq(`tiny := 0.000001280`)
#eq(`negative := -0.00123456 * 1.00`)
#eq(`scientificcarry := 9.999e-7 * 1.00`)
#eq(`zero := 0`)
#eq(`1.234 ± 0.1234`)
#eq(`v := vec(0.00123456, 12345.6)`)
#eq(`third := 1.00 / 3.00`)
#eq(`whole := third * 3.00`)
#eq(`decimal := 1 / 3`, digits: 2)
#eq(`legacy := 1.2 + 3.456`, auto-digits: "decimal")
#context {
  let r = eq()
  assert(r.torque.value == 0.32)
  assert(r.torque.significant-digits == 3)
  assert("[0.320]" in repr(r.torque.display.body))
  assert(r.inertia.value == 0.00000128)
  assert("[1.28]" in repr(r.inertia.display.body))
  assert(r.acceleration.value == 250000)
  assert(r.again.significant-digits == 3)
  assert(r.tiny.significant-digits == 4)
  assert("[1.280]" in repr(r.tiny.display.body))
  assert(r.negative.value == -0.00123)
  assert(r.scientificcarry.value == 0.000001)
  assert("[1.00]" in repr(r.scientificcarry.display.body))
  assert(r.zero.value == 0)
  assert(r.v.components.at(0).value == 0.00123456)
  assert(r.v.components.at(1).value == 12345.6)
  assert(r.third.value == 0.333)
  assert(r.whole.value == 1)
  assert(r.decimal.value == 0.33)
  assert("significant-digits" not in r.decimal)
  assert(r.legacy.value == 4.7)
  assert(calc.abs(r.acceleration.exact - 250000) < 1e-8)
}
#let legacy = calculation-builder(key: "legacy", digits: auto, strict: true)
#legacy(`torque := 4 cm * 8 N to N*m`)
#legacy(`switched := 4 cm * 8 N to N*m`, auto-digits: "significant")
#context {
  assert(legacy().torque.value == 0)
  assert(legacy().switched.value == 0.3)
  assert(legacy().switched.exact == 0.32)
}
#let fixed = calculation-builder(key: "fixed", digits: 3, auto-digits: "significant", strict: true)
#fixed(`x := 1 / 3`)
#context { assert(fixed().x.value == 0.333) }
